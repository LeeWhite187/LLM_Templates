<?xml version="1.0" encoding="utf-8"?>
<!--
  Facility Dashboard Platform - WiX MSI (FR-70..FR-74, KD-20).

  Install:   places the self-contained service (with both Angular bundles under wwwroot), the
             standalone recovery tool, the database tool and migration artifacts; registers and
             starts the Windows Service under the chosen account; provisions the inbound firewall
             rule; writes deploy-time configuration; creates the schema on a fresh database.
  Upgrade:   strictly-newer only (downgrades and same-version blocked); stops the service,
             removes the old files (including superseded bundle files - MajorUpgrade uninstalls
             before installing), installs the new ones, restarts. Existing databases are NEVER
             migrated automatically: fd-dbtool detects the need; APPLYMIGRATIONS=1 is the
             explicit opt-in, otherwise the operator runs `fd-dbtool apply` after a backup.

  Property-driven configuration (silent or command-line install):
    msiexec /i FacilityDashboards-x.y.z.msi /qn
      CONNECTIONSTRING="Server=...;Database=FacilityDashboards;Trusted_Connection=True;"
      PORT=8443 BOOTSTRAPADMIN="DOMAIN\admin" MEDIAPATH="D:\dashboards\media"
      SERVICEACCOUNT="DOMAIN\svc-dashboards" SERVICEPASSWORD="..." APPLYMIGRATIONS=0
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Facility Dashboard Platform"
           Manufacturer="Facility Dashboard Platform"
           Version="$(var.ProductVersion)"
           UpgradeCode="6f1f3c4e-9a7b-4f7e-8e57-2a36f0d52f10"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">

    <!-- FR-71: proceed only when strictly newer; block downgrades and same-version reinstall.
         Schedule=afterInstallExecute removes the old product AFTER the new one installs, inside
         the transaction: (1) the never-overwrite appsettings.json still exists at costing, so the
         operator's configuration genuinely survives the upgrade; (2) a failed upgrade rolls back
         to the old version instead of leaving nothing installed (the earlier-removal schedule
         deletes the old product before the transaction starts, then costing has already decided
         to skip never-overwrite files — the config write then fails on a missing file).
         Superseded files are still removed: components absent from the new package are deleted
         when the old product is removed; shared components are reference-counted and kept. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of the Facility Dashboard Platform is already installed."
                  AllowSameVersionUpgrades="no"
                  Schedule="afterInstallExecute" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Every run of this package (interactive or silent) writes a full verbose log to the
         invoking user's %TEMP% as MSI*.LOG — no /l*v needed. 'voicewarmupx' = verbose, out-of-
         memory, in/out of script, action data, custom action output, property dumps, plus
         extra debug. The newest MSI*.LOG in %TEMP% after a failed install is the one to read. -->
    <Property Id="MsiLogging" Value="voicewarmupx" />

    <!-- Deploy-time configuration properties (§11.2). CONNECTIONSTRING may be passed whole on
         the command line; otherwise it is composed from the DB* parts captured by the database
         wizard page (or their defaults) by the BuildConnectionString action. -->
    <Property Id="CONNECTIONSTRING" Secure="yes" />
    <Property Id="DBSERVER" Value="(localdb)\MSSQLLocalDB" Secure="yes" />
    <Property Id="DBNAME" Value="FacilityDashboards" Secure="yes" />
    <Property Id="DBAUTH" Value="windows" Secure="yes" />
    <Property Id="DBUSER" Secure="yes" />
    <Property Id="DBPASSWORD" Hidden="yes" Secure="yes" />
    <Property Id="SKIPDBTEST" Secure="yes" />
    <Property Id="CONNTEST_OK" Value="0" />
    <Property Id="PORT" Value="8443" />

    <!-- Context check: where a previous installation recorded itself, so the wizard can pre-fill
         from (and upgrades preserve) the existing appsettings.json. -->
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PrevInstallDirSearch" Root="HKLM" Key="SOFTWARE\FacilityDashboards"
                      Name="InstallDir" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" After="AppSearch"
                 Sequence="both" Condition="PREVIOUSINSTALLFOLDER" />
    <Property Id="MEDIAPATH" Value="C:\ProgramData\FacilityDashboards\media" />
    <Property Id="DATAPATH" Value="C:\ProgramData\FacilityDashboards" />
    <Property Id="TLSMODE" Value="kestrel" />
    <Property Id="BOOTSTRAPADMIN" Secure="yes" />
    <!-- CreateService accepts the literal "LocalSystem"; an EMPTY formatted account would make
         service registration fail with the misleading MSI error 1923 ("verify that you have
         sufficient privileges to install system services"), so the default must never be empty. -->
    <Property Id="SERVICEACCOUNT" Value="LocalSystem" Secure="yes" />
    <Property Id="SERVICEPASSWORD" Hidden="yes" Secure="yes" />
    <Property Id="SMTPHOST" Secure="yes" />
    <Property Id="SMTPRECIPIENTS" Secure="yes" />
    <Property Id="BACKUPPATH" Secure="yes" />
    <!-- FR-74: explicit opt-in to apply migrations on upgrade; never automatic. -->
    <Property Id="APPLYMIGRATIONS" Value="0" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FacilityDashboards">
        <Directory Id="ServiceDir" Name="service" />
        <Directory Id="RecoveryDir" Name="recovery" />
        <Directory Id="DbToolDir" Name="dbtool" />
        <Directory Id="SqlDir" Name="sql" />
      </Directory>
    </StandardDirectory>

    <!-- The service executable owns the Windows Service registration (FR-70). -->
    <Component Id="ServiceExe" Directory="ServiceDir" Guid="8d3b1a52-7c44-4b2e-b8a1-5fbb0f6f2a01">
      <File Id="HostExe" Source="$(var.StagingDir)\service\Dashboards.Host.exe" KeyPath="yes" />
      <ServiceInstall Id="FdService"
                      Name="FacilityDashboards"
                      DisplayName="Facility Dashboard Platform"
                      Description="Serves facility dashboards to display stations and hosts the authoring platform."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="[SERVICEACCOUNT]"
                      Password="[SERVICEPASSWORD]"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                            ThirdFailureActionType="restart" RestartServiceDelayInSeconds="30" />
      </ServiceInstall>
      <!-- FR-71: stop on upgrade/uninstall (waited, so files can be replaced). The post-install
           START is deliberately NOT a ServiceControl row: MSI fails the whole install with error
           1920 when a started service exits — which this service does by design when the schema
           gate (FR-72) or database is not ready. A best-effort `sc start` custom action below
           starts it instead, and a service that refuses to start explains itself in its own log. -->
      <ServiceControl Id="FdServiceStop" Name="FacilityDashboards"
                      Stop="both" Remove="uninstall" Wait="yes" />

      <!-- FR-70: inbound firewall rule for the listening port, internal profiles only. -->
      <fw:FirewallException Id="FdFirewallDomain" Name="Facility Dashboard Platform (HTTPS)"
                            Port="[PORT]" Protocol="tcp" Profile="domain" Scope="any" />
      <fw:FirewallException Id="FdFirewallPrivate" Name="Facility Dashboard Platform (HTTPS, private)"
                            Port="[PORT]" Protocol="tcp" Profile="private" Scope="any" />
    </Component>

    <!-- Operator-editable configuration survives upgrades (FR-71: replace binaries, keep config). -->
    <Component Id="ServiceConfig" Directory="ServiceDir" Guid="2f9a4c1d-4e6b-49b3-9a6e-7d2c8f0b3a02" NeverOverwrite="yes">
      <File Id="AppSettings" Source="$(var.StagingDir)\service\appsettings.json" KeyPath="yes" />
    </Component>

    <Component Id="ConfigScript" Directory="ServiceDir" Guid="b71d2e83-95cf-4a44-8d20-91c4f5e6aa03">
      <File Id="SetConfigPs1" Source="$(var.StagingDir)\service\set-config.ps1" KeyPath="yes" />
    </Component>

    <!-- Records the install location so later installs/upgrades can find the existing config. -->
    <Component Id="InstallLocationReg" Directory="INSTALLFOLDER" Guid="4c8e9f21-6b3a-47d5-92e8-1a5d7c0e4b04">
      <RegistryValue Root="HKLM" Key="SOFTWARE\FacilityDashboards" Name="InstallDir"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <!-- Everything else in the service layout: runtime files and both Angular bundles. The
         wildcard harvest plus MajorUpgrade's uninstall-then-install removes superseded bundle
         files rather than overlaying them (FR-71). -->
    <ComponentGroup Id="ServicePayload" Directory="ServiceDir">
      <Files Include="$(var.StagingDir)\service\**">
        <Exclude Files="$(var.StagingDir)\service\Dashboards.Host.exe" />
        <Exclude Files="$(var.StagingDir)\service\appsettings.json" />
        <Exclude Files="$(var.StagingDir)\service\set-config.ps1" />
      </Files>
    </ComponentGroup>

    <!-- The standalone recovery tool (FR-90), installed alongside the service. -->
    <ComponentGroup Id="RecoveryPayload" Directory="RecoveryDir">
      <Files Include="$(var.StagingDir)\recovery\**" />
    </ComponentGroup>

    <!-- The database tool and migration artifacts (FR-73, FR-74). -->
    <ComponentGroup Id="DbToolPayload" Directory="DbToolDir">
      <Files Include="$(var.StagingDir)\dbtool\**" />
    </ComponentGroup>
    <ComponentGroup Id="SqlPayload" Directory="SqlDir">
      <Files Include="$(var.StagingDir)\sql\**" />
    </ComponentGroup>

    <Feature Id="Main" Title="Facility Dashboard Platform" Level="1">
      <ComponentRef Id="ServiceExe" />
      <ComponentRef Id="ServiceConfig" />
      <ComponentRef Id="ConfigScript" />
      <ComponentRef Id="InstallLocationReg" />
      <ComponentGroupRef Id="ServicePayload" />
      <ComponentGroupRef Id="RecoveryPayload" />
      <ComponentGroupRef Id="DbToolPayload" />
      <ComponentGroupRef Id="SqlPayload" />
    </Feature>

    <!-- Deploy-time configuration capture (§11.2): patch appsettings.json from MSI properties.
         The command line is composed by the managed BuildConfigureCommand action, which omits any
         setting still at its installer default so upgrades never reset operator-edited values. -->
    <CustomAction Id="ConfigureAppSettings" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- FR-73: create the schema on a fresh database. Never migrates an existing one (exit 3 is
         reported, not fatal): the operator applies migrations explicitly (FR-74). -->
    <SetProperty Id="EnsureDatabase"
                 Value="&quot;[DbToolDir]fd-dbtool.exe&quot; ensure --fresh-only --config &quot;[ServiceDir]appsettings.json&quot;"
                 Sequence="execute" Before="EnsureDatabase" />
    <CustomAction Id="EnsureDatabase" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- FR-74: the explicit opt-in path applies the shipped idempotent migrations. -->
    <SetProperty Id="ApplyMigrations"
                 Value="&quot;[DbToolDir]fd-dbtool.exe&quot; apply --config &quot;[ServiceDir]appsettings.json&quot;"
                 Sequence="execute" Before="ApplyMigrations" />
    <CustomAction Id="ApplyMigrations" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- Best-effort service start after registration; failure to start is the service's own
         story (schema gate / unreachable database), never an install failure. -->
    <SetProperty Id="StartFdService"
                 Value="&quot;[System64Folder]sc.exe&quot; start FacilityDashboards"
                 Sequence="execute" Before="StartFdService" />
    <CustomAction Id="StartFdService" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Managed custom actions: existing-config detection, connection-string composition, and
         the wizard's credential test (run in the UI sequence via DoAction). -->
    <Binary Id="InstallerActionsCA" SourceFile="$(var.CAFile)" />
    <CustomAction Id="ReadExistingConfig" BinaryRef="InstallerActionsCA" DllEntry="ReadExistingConfig"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="BuildConnectionString" BinaryRef="InstallerActionsCA" DllEntry="BuildConnectionString"
                  Execute="immediate" Return="check" />
    <CustomAction Id="BuildConfigureCommand" BinaryRef="InstallerActionsCA" DllEntry="BuildConfigureCommand"
                  Execute="immediate" Return="check" />
    <CustomAction Id="TestDbConnection" BinaryRef="InstallerActionsCA" DllEntry="TestDbConnection"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Silent installs and upgrades take the same path as the wizard: prime from the existing
           config, then compose CONNECTIONSTRING — so a /qn upgrade preserves the operator's
           connection settings instead of resetting them to defaults. -->
      <Custom Action="ReadExistingConfig" After="CostFinalize" Condition="NOT REMOVE" />
      <Custom Action="BuildConnectionString" After="ReadExistingConfig" Condition="NOT REMOVE" />
      <Custom Action="BuildConfigureCommand" After="BuildConnectionString" Condition="NOT REMOVE" />
      <Custom Action="ConfigureAppSettings" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="EnsureDatabase" After="ConfigureAppSettings" Condition="NOT REMOVE" />
      <Custom Action="ApplyMigrations" After="EnsureDatabase" Condition="(NOT REMOVE) AND (APPLYMIGRATIONS=&quot;1&quot;)" />
      <!-- Start as late as possible: on an upgrade, RemoveExistingProducts (scheduled
           afterInstallExecute) runs near the end of the sequence and the old product's removal
           pass could otherwise stop the service we just started. -->
      <Custom Action="StartFdService" Before="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- ================= Database wizard page ================= -->
    <UI>
      <Dialog Id="DatabaseDlg" Width="370" Height="270" Title="Facility Dashboard Platform Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Database connection" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="24" Transparent="yes" NoPrefix="yes"
                 Text="Where the platform stores its configuration. The connection is tested before setup continues; a test can take up to 30 seconds, and the wizard will not respond while it runs." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="ExistingNote" Type="Text" X="25" Y="52" Width="320" Height="12" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Normal}Settings below were loaded from the existing installation."
                 ShowCondition="EXISTINGCONFIGFOUND" HideCondition="NOT EXISTINGCONFIGFOUND" />

        <Control Id="ServerLabel" Type="Text" X="25" Y="70" Width="100" Height="12" NoPrefix="yes" Text="SQL Server instance:" />
        <Control Id="ServerEdit" Type="Edit" X="130" Y="68" Width="215" Height="16" Property="DBSERVER" />

        <Control Id="DbLabel" Type="Text" X="25" Y="92" Width="100" Height="12" NoPrefix="yes" Text="Database name:" />
        <Control Id="DbEdit" Type="Edit" X="130" Y="90" Width="215" Height="16" Property="DBNAME" />

        <Control Id="AuthLabel" Type="Text" X="25" Y="116" Width="100" Height="12" NoPrefix="yes" Text="Authentication:" />
        <Control Id="AuthGroup" Type="RadioButtonGroup" X="130" Y="112" Width="220" Height="36" Property="DBAUTH" />

        <Control Id="UserLabel" Type="Text" X="25" Y="156" Width="100" Height="12" NoPrefix="yes" Text="SQL login:"
                 EnableCondition="DBAUTH = &quot;sql&quot;" DisableCondition="DBAUTH &lt;&gt; &quot;sql&quot;" />
        <Control Id="UserEdit" Type="Edit" X="130" Y="154" Width="215" Height="16" Property="DBUSER"
                 EnableCondition="DBAUTH = &quot;sql&quot;" DisableCondition="DBAUTH &lt;&gt; &quot;sql&quot;" />

        <Control Id="PassLabel" Type="Text" X="25" Y="178" Width="100" Height="12" NoPrefix="yes" Text="Password:"
                 EnableCondition="DBAUTH = &quot;sql&quot;" DisableCondition="DBAUTH &lt;&gt; &quot;sql&quot;" />
        <Control Id="PassEdit" Type="Edit" X="130" Y="176" Width="215" Height="16" Property="DBPASSWORD" Password="yes"
                 EnableCondition="DBAUTH = &quot;sql&quot;" DisableCondition="DBAUTH &lt;&gt; &quot;sql&quot;" />

        <Control Id="TestBtn" Type="PushButton" X="130" Y="200" Width="100" Height="17" Text="&amp;Test connection">
          <Publish Event="DoAction" Value="TestDbConnection" Order="1" Condition="1" />
          <!-- Native feedback: message boxes from a custom action are suppressed inside a
               dialog's event loop, so the result is shown by spawning an MSI dialog whose text
               reads CONNTEST_RESULT at creation. -->
          <Publish Event="SpawnDialog" Value="DbTestResultDlg" Order="2" Condition="1" />
        </Control>
        <Control Id="SkipTest" Type="CheckBox" X="240" Y="202" Width="120" Height="14"
                 Property="SKIPDBTEST" CheckBoxValue="1" Text="Skip the connection test" />

        <Control Id="WindowsAuthNote" Type="Text" X="25" Y="220" Width="330" Height="12" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Normal}Windows authentication uses the service account; grant it access to the database." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>

      <RadioButtonGroup Property="DBAUTH">
        <RadioButton Value="windows" X="0" Y="0" Width="220" Height="16" Text="Windows (the service's account)" />
        <RadioButton Value="sql" X="0" Y="18" Width="220" Height="16" Text="SQL Server login" />
      </RadioButtonGroup>

      <!-- The connection-test result, spawned after the test action so its text control reads the
           freshly written CONNTEST_RESULT property at creation. -->
      <Dialog Id="DbTestResultDlg" Width="320" Height="140" Title="Database connection test">
        <Control Id="ResultText" Type="Text" X="20" Y="15" Width="280" Height="85" NoPrefix="yes" Text="[CONNTEST_RESULT]" />
        <Control Id="OK" Type="PushButton" X="132" Y="110" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" Condition="1" />
        </Control>
      </Dialog>

      <!-- ===== The full dialog set: WixUI_InstallDir's navigation with DatabaseDlg inserted
           between InstallDirDlg and VerifyReadyDlg. A custom set (rather than appended publishes)
           is required because a stock NewDialog row would always fire first and switch dialogs
           before appended events run. Mirrors src/ext/UI/wixlib/WixUI_InstallDir.wxs. ===== -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="CheckTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="3" />
      <!-- The inserted step: pre-fill from an existing installation, then show the database page. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="ReadExistingConfig" Order="4" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="DatabaseDlg" Order="5" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="CheckTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SetTargetPath" Value="[_BrowseProperty]" Order="3" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="EndDialog" Value="Return" Order="4" />

      <Publish Dialog="DatabaseDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Condition="1" />
      <!-- The credential test gates Next (unless explicitly skipped): the test action publishes
           CONNTEST_OK=1 and the composed CONNECTIONSTRING only when the login succeeds. On
           failure the result dialog explains, and the wizard stays on this page. -->
      <Publish Dialog="DatabaseDlg" Control="Next" Event="DoAction" Value="TestDbConnection" Order="1"
               Condition="SKIPDBTEST &lt;&gt; &quot;1&quot;" />
      <Publish Dialog="DatabaseDlg" Control="Next" Event="SpawnDialog" Value="DbTestResultDlg" Order="2"
               Condition="(CONNTEST_OK &lt;&gt; &quot;1&quot;) AND (SKIPDBTEST &lt;&gt; &quot;1&quot;)" />
      <Publish Dialog="DatabaseDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3"
               Condition="CONNTEST_OK = &quot;1&quot; OR SKIPDBTEST = &quot;1&quot;" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="DatabaseDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <UIRef Id="WixUI_Common" />

  </Package>
</Wix>
