<?xml version="1.0" encoding="UTF-16"?>
<!--
  Daily host-survey task definition, registered via:
    schtasks /create /tn "\OGA\HostSurvey" /xml SurveyTask.xml /f

  Runs as SYSTEM (S-1-5-18): elevated, no stored password, and its network identity is the machine
  account — which is what lets the survey verify the domain secure channel / predict Kerberos
  failure. {{INSTALLFOLDER}} in <Command> is substituted to the chosen install path at install
  time (or hardcode it for a fixed ProgramFiles layout).

  Note: Task Scheduler XML is conventionally UTF-16; keep this file UTF-16 if you edit it.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>OGA Host Survey - daily build-data collection.</Description>
    <URI>\OGA\HostSurvey</URI>
  </RegistrationInfo>

  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T02:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <!-- Spread a fleet across an hour so hosts don't all hit the listener at once. -->
      <RandomDelay>PT1H</RandomDelay>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
      <!-- Omit <LogonType> for a SYSTEM (S-1-5-18) principal: including ServiceAccount fails
           schtasks validation. Windows' own exported SYSTEM tasks omit it. -->
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- VMs frequently report "on battery"; never let that block or stop the run. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <!-- The crucial VM setting: run a missed schedule as soon as the VM is back up. -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT15M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>{{INSTALLFOLDER}}OGA.HostSurvey.Agent.exe</Command>
      <Arguments>--scheduled</Arguments>
    </Exec>
  </Actions>
</Task>
